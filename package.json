{
  "name": "builtin.language-features-nvmrc-monorepo",
  "version": "0.0.0-dev",
  "description": "Nvmrc language features extension monorepo for Lvce Editor",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node packages/build/src/build.js",
    "build:extension": "node packages/build/src/build-extension.js",
    "dev": "node packages/build/src/dev.js",
    "e2e": "npm run e2e --workspace=packages/e2e",
    "e2e:headless": "npm run e2e:headless --workspace=packages/e2e",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check . && knip --no-config-hints",
    "test": "npm test --workspaces --if-present",
    "type-check": "tsc -b"
  },
  "author": "Lvce Editor",
  "license": "MIT",
  "devDependencies": {
    "@lvce-editor/eslint-config": "^18.4.0",
    "@types/node": "^26.1.1",
    "eslint": "^10.8.1",
    "knip": "^6.29.0",
    "prettier": "^4.0.0-alpha.10",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  }
}
