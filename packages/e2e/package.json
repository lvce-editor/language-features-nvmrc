{
  "name": "e2e",
  "version": "0.0.0-dev",
  "description": "End-to-end tests for the nvmrc language features extension",
  "main": "index.js",
  "scripts": {
    "build:extension": "node ../build/src/build-extension.js",
    "e2e": "npm run build:extension && node ./node_modules/@lvce-editor/test-with-playwright/bin/test-with-playwright.js --only-extension=../extension --test-path=. --server-path=../server/node_modules/@lvce-editor/server/src/server.js",
    "e2e:headless": "npm run build:extension && node ./node_modules/@lvce-editor/test-with-playwright/bin/test-with-playwright.js --only-extension=../extension --test-path=. --server-path=../server/node_modules/@lvce-editor/server/src/server.js --headless"
  },
  "type": "module",
  "author": "Lvce Editor",
  "license": "MIT",
  "devDependencies": {
    "@lvce-editor/test-with-playwright": "^10.3.0"
  }
}
