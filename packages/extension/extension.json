{
  "id": "builtin.language-features-nvmrc",
  "name": "Language Features Nvmrc",
  "description": "Provides language support for .nvmrc files",
  "repository": "https://github.com/lvce-editor/language-features-nvmrc",
  "browser": "dist/languageFeaturesNvmrcMain.js",
  "isolated": true,
  "contentSecurityPolicy": [
    "default-src 'none'",
    "connect-src https://nodejs.org",
    "script-src 'self'"
  ],
  "icon": "./media/icon.png",
  "categories": ["Programming Languages"],
  "activation": [
    "onLanguage:nvmrc",
    "onCompletion:nvmrc",
    "onDiagnostic:nvmrc",
    "onCommand:nvmrc.test.setNodeReleases"
  ],
  "commands": [
    {
      "id": "nvmrc.test.setNodeReleases",
      "label": "Nvmrc: Set Test Node Releases"
    }
  ],
  "completionProviders": [
    {
      "id": "nvmrc",
      "languageId": "nvmrc"
    }
  ],
  "diagnosticProviders": [
    {
      "id": "nvmrc.provideDiagnostics",
      "languageId": "nvmrc"
    }
  ],
  "languages": [
    {
      "id": "nvmrc",
      "extensions": [".nvmrc"],
      "fileNames": [".nvmrc"]
    }
  ]
}
